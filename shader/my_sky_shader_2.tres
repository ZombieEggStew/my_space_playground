[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_rwbhc"]
size = Vector2(720, 980)
expression = "// 预先声明变量
vec2 uv = vec2(atan(dir.x, dir.z) / (2.0 * PI) + 0.5, asin(clamp(dir.y, -1.0, 1.0)) / PI + 0.5);
vec2 p_grid = uv * star_scale;
vec2 n = floor(p_grid);
vec2 f = fract(p_grid);

brightness = 0.0;
star_seed = 0.0;

for (int j = -2; j <= 2; j++) {
    for (int i = -2; i <= 2; i++) {
        vec2 cell = n + vec2(float(i), float(j));
        
        // 内联 hash22 逻辑：p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
        vec2 h_p = cell + vec2(seed, seed * 1.37);
        float h_x = dot(h_p, vec2(127.1, 311.7));
        float h_y = dot(h_p, vec2(269.5, 183.3));
        vec2 rnd = fract(sin(vec2(h_x, h_y)) * 43758.5453123);

        vec2 starPos = vec2(float(i), float(j)) + rnd - f;
        float d = length(starPos);
        float r = star_size + rnd.x * star_size_var;
        float t = clamp(1.0 - d / r, 0.0, 1.0);
        float contrib = t * t;
        float inten = 0.5 + rnd.y * 1.5;
        
        float val = contrib * inten * star_density;
        brightness += val;
        
        // 记录随机种子用于颜色采样
        if (val > 0.001) {
            star_seed = rnd.y;
        }
    }
}

brightness = clamp(brightness, 0.0, 1.0);"

